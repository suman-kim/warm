# ------------------------------------------------------------------------------
# MOVO 백엔드 환경변수 — 로컬(개발) 템플릿
#
#   cp .env.local.example .env.local  →  JWT_SECRET 채우기  →  npm run start:local
#
# 환경은 local과 prod 두 가지다. 서버는 .env.${APP_ENV}를 읽고(APP_ENV 미지정 시 local),
# 없는 값은 .env에서 채운다. 운영은 .env.prod.example을 본다.
# 실제 값이 든 .env.local / .env.prod는 커밋하지 않는다.
# 검증 규칙은 src/config/env.validation.ts가 기준이다. 틀리면 부팅이 실패한다.
# ------------------------------------------------------------------------------

# development | production | test (선택, 기본 development)
# production이면 Swagger(/api/docs)가 꺼지고 CORS_ORIGINS에 적은 오리진만 허용한다.
NODE_ENV=development
# 서버 포트 (선택, 기본 4000)
PORT=4000

# ---- PostgreSQL (필수) ----
# 스키마는 마이그레이션으로만 바꾼다: npm run migration:run
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=movo
DB_PASSWORD=movo
DB_DATABASE=movo
# 암호화 연결 (선택, 기본 false). 관리형 DB(RDS 등)는 true.
# DB_SSL=true

# ---- 인증 (JWT) ----
# 필수, 32자 이상. 만들기: openssl rand -hex 32
JWT_SECRET=
# 액세스 토큰 만료 (선택, 기본 30m)
JWT_ACCESS_EXPIRES_IN=30m
# 리프레시 토큰 유효기간(일) (선택, 기본 30, 1~365)
JWT_REFRESH_EXPIRES_DAYS=30

# ---- CORS ----
# 브라우저로 접근하는 오리진(관리자 웹 등), 콤마 구분. 개발에서는 비우면 전부 허용.
# 네이티브 앱은 Origin을 보내지 않아 이 목록과 무관하다.
CORS_ORIGINS=

# ---- 주소 검색 / 카카오 (선택) ----
# 카카오디벨로퍼스 > 내 애플리케이션 > 앱 키의 'REST API 키'. 카카오맵(로컬 API)을 켜 둔 앱이어야 한다.
# 서버만 쓴다 — 앱에 넣지 않는다. 비우면 견본 주소 몇 곳에서만 찾는다 (운영에서는 필수).
KAKAO_REST_API_KEY=

# ---- 푸시 알림 / FCM (선택) ----
# iOS·Android 모두 FCM으로 보낸다. 비우면 발송이 꺼지고 보낼 알림은 서버 로그로만 남는다.
# 고객 앱과 기사 앱을 같은 Firebase 프로젝트에 등록하면 이 서비스 계정 하나로 두 앱 모두에 보낸다.
# Firebase 콘솔 > 프로젝트 설정 > 서비스 계정 > '새 비공개 키 생성'으로 받은 JSON 파일을
# 통째로 base64 인코딩해 한 줄로 넣는다:  base64 -i service-account.json | tr -d '\n'
# 비공개 키가 들어 있다 — 저장소에 올리지 않는다. 형식이 틀리면 서버가 뜨지 않는다.
FIREBASE_SERVICE_ACCOUNT_BASE64=

# ---- 정산 (선택) ----
# 배송 한 건의 요금에서 떼는 수수료율(%) (기본 10). 기사 앱의 수입과 운영자 웹의 정산이 함께 바뀐다.
# COMMISSION_RATE_PERCENT=10
# 정산 지급 요일 (기본 2). 0 = 일요일 … 6 = 토요일. 한 주(월~일)의 운행분을 그다음 주의 이 요일에 지급한다.
# SETTLEMENT_PAYOUT_WEEKDAY=2
# 고객이 낸 취소 수수료·노쇼 요금 중 기사에게 주는 몫(%) (기본 0 — 플랫폼이 모두 갖는다).
# DRIVER_CANCELLATION_SHARE_PERCENT=0

# ---- 운영자 웹 (선택) ----
# 운영자 초대 링크가 가리키는 운영자 웹 주소 (기본 http://localhost:5174).
# 메일 발송을 붙이기 전이라, 개발에서는 초대 링크가 서버 로그에 찍힌다.
# ADMIN_WEB_URL=http://localhost:5174

# ---- 파일 보관 (기사 서류) ----
# 올린 서류를 두는 폴더 (선택, 기본 ./uploads). 서버가 한 대일 때만 맞다 —
# 여러 대로 늘리거나 디스크가 지워지는 환경(컨테이너)이면 객체 저장소 구현으로 바꾼다.
# 신분증·면허증이 들어 있다 — 웹 서버가 직접 내보내는 경로에 두지 않는다.
# UPLOAD_DIR=./uploads

# ---- 고객센터 연락처 (선택) ----
# 앱의 고객센터 화면에 그대로 보인다 (GET /api/support/contact). 비우면 그 항목은 null.
SUPPORT_PHONE=
SUPPORT_EMAIL=
# 예: 평일 09:00~18:00
SUPPORT_HOURS=
SUPPORT_KAKAO_CHANNEL_URL=

# ---- 사업자 정보 (선택) ----
# 앱의 사업자 정보 화면에 보인다 (GET /api/support/business, 전화·운영 시간·이메일은 SUPPORT_*). 비우면 그 항목은 null.
BUSINESS_NAME=
BUSINESS_REPRESENTATIVE=
# 예: 214-88-01234
BUSINESS_REGISTRATION_NUMBER=
# 통신판매업 신고번호. 예: 제2026-서울성동-0812호
BUSINESS_MAIL_ORDER_NUMBER=
BUSINESS_ADDRESS=

# ---- 결제 / 포트원 (선택) ----
# 포트원 V2로 카드 등록(빌링키)·결제·취소를 한다. PG사는 나이스페이먼츠(포트원 콘솔의 채널).
# 셋 다 비우면 개발용 결제(DevPaymentGateway)로 돈다 — 돈이 오가지 않고, 앱은 개발용 카드 등록 화면을 띄운다.
# 포트원 콘솔 > 결제 연동 > 연동 정보에서 상점 아이디와 V2 API Secret을, 채널 관리에서 채널 키를 복사한다.
# 테스트 채널이면 실제 돈이 나가지 않는다. API Secret은 서버만 쓴다 — 앱에 넣지 않는다.
PORTONE_STORE_ID=
PORTONE_CHANNEL_KEY=
PORTONE_API_SECRET=
