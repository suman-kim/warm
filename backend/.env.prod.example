# ------------------------------------------------------------------------------
# MOVO 백엔드 환경변수 — 운영 템플릿
#
#   cp .env.prod.example .env.prod  →  값 채우기  →  npm run build
#   APP_ENV=prod npm run migration:run  →  npm run start:prod
#
# 각 변수의 자세한 뜻은 .env.local.example에 있다. 여기에는 운영에서 달라지는 값과 꼭 채울 값만 적는다.
# 비밀값(DB 비밀번호, JWT_SECRET, Firebase 키, 포트원 API Secret)이 들어간다 — .env.prod는 커밋하지 않는다.
# 플랫폼 환경변수로 넣어도 된다 (같은 이름이면 플랫폼 값이 우선한다).
# ------------------------------------------------------------------------------

# Swagger(/api/docs)를 끄고 CORS_ORIGINS의 오리진만 허용한다.
NODE_ENV=production
PORT=4000

# ---- PostgreSQL (필수) ----
DB_HOST=
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=movo
# 관리형 DB(RDS 등)는 암호화 연결을 켠다.
DB_SSL=true

# ---- 인증 (JWT) ----
# 필수, 32자 이상. 로컬과 다른 값을 쓴다: openssl rand -hex 32
JWT_SECRET=
JWT_ACCESS_EXPIRES_IN=30m
JWT_REFRESH_EXPIRES_DAYS=30

# ---- CORS ----
# 운영자 웹의 주소 (예: https://admin.example.com). 비우면 브라우저에서 아무 곳도 붙지 못한다.
CORS_ORIGINS=

# ---- 운영자 웹 ----
# 운영자 초대 링크가 가리키는 주소. CORS_ORIGINS와 같은 운영자 웹 주소.
ADMIN_WEB_URL=

# ---- 주소 검색 / 카카오 (필수) ----
# 카카오디벨로퍼스의 REST API 키. 없으면 서버가 뜨지 않는다.
KAKAO_REST_API_KEY=

# ---- 결제 / 포트원 ----
# 포트원 V2 상점 아이디, 실연동 채널(지금은 나이스페이먼츠)의 키, V2 API Secret.
# 주문앱(따끈) 손님 결제·환불에 쓴다. 비어 있으면 운영 서버는 주문앱 결제를 받지 않는다(503).
# TODO: 가게 충전금 충전도 붙이면 쓴다 (작업 35.2). 그 전에는 운영 서버에서 충전이 막혀 있다.
PORTONE_STORE_ID=
PORTONE_CHANNEL_KEY=
PORTONE_API_SECRET=
# 포트원 콘솔 > 결제 연동 > 웹훅의 시크릿. 웹훅 주소는 https://<서버>/api/webhooks/payments
PORTONE_WEBHOOK_SECRET=

# ---- 푸시 알림 / FCM ----
# 서비스 계정 JSON을 base64로: base64 -i service-account.json | tr -d '\n'
FIREBASE_SERVICE_ACCOUNT_BASE64=

# ---- 파일 보관 (기사 서류) ----
# 서버가 지워지지 않는 디스크의 경로를 준다 (기본 ./uploads). 신분증·면허증이 들어 있다 —
# 웹 서버가 직접 내보내는 경로에 두지 않는다.
# UPLOAD_DIR=/var/lib/movo/uploads

# ---- 정산 ----
COMMISSION_RATE_PERCENT=10
SETTLEMENT_PAYOUT_WEEKDAY=2
DRIVER_CANCELLATION_SHARE_PERCENT=0

# ---- 고객센터 연락처 ----
SUPPORT_PHONE=
SUPPORT_EMAIL=
SUPPORT_HOURS=
SUPPORT_KAKAO_CHANNEL_URL=

# ---- 사업자 정보 (전자상거래법 표시 의무 — 운영 전에 채운다) ----
BUSINESS_NAME=
BUSINESS_REPRESENTATIVE=
BUSINESS_REGISTRATION_NUMBER=
BUSINESS_MAIL_ORDER_NUMBER=
BUSINESS_ADDRESS=
